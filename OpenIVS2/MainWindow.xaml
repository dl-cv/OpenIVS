<Window x:Class="OpenIVS2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="OpenIVS2 - 多相机工业视觉检测" Width="1440" Height="900" MinWidth="1100" MinHeight="700"
        Background="#F5F5F5" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#ECEFF1" BorderThickness="0,0,0,1">
            <Grid Margin="18,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="BrandLogo" Source="logo.ico" Height="44" Stretch="Uniform" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="OpenIVS2" FontSize="23" FontWeight="Bold" Foreground="#263238"/>
                        <TextBlock Text="多相机工业视觉检测" FontSize="12" Foreground="#607D8B"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="StartButton" Content="开始运行" Style="{StaticResource SuccessButtonStyle}" Click="StartButton_Click"/>
                    <Button x:Name="StopButton" Content="停止" Style="{StaticResource DangerButtonStyle}" Click="StopButton_Click" IsEnabled="False"/>
                    <Button x:Name="TriggerButton" Content="单次触发" Style="{StaticResource ToolbarButtonStyle}" Click="TriggerButton_Click" IsEnabled="False"/>
                    <Button x:Name="SettingsButton" Content="设置" Style="{StaticResource SecondaryButtonStyle}" Click="SettingsButton_Click"/>
                    <Button x:Name="ResetButton" Content="计数清零" Style="{StaticResource SecondaryButtonStyle}" Click="ResetButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="12,10,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="6">
                <primitives:UniformGrid x:Name="CameraGrid" Rows="1" Columns="1"/>
            </Border>
            <Grid Grid.Column="1" Margin="6,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="180"/>
                    <RowDefinition Height="150"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" x:Name="OverallResultCard" Style="{StaticResource CardStyle}" Background="#90A4AE">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="OverallResultHeaderText" Text="总结果" Foreground="White" FontSize="16" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="OverallResultText" Text="待机" Foreground="White" FontSize="64" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4"/>
                        <TextBlock x:Name="CycleDetailText" Text="等待触发" Foreground="White" FontSize="13" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="生产统计" Style="{StaticResource SectionTitleStyle}"/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center"><TextBlock Text="总数" Foreground="#607D8B" HorizontalAlignment="Center"/><TextBlock x:Name="TotalCountText" Text="0" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="OK" Foreground="#607D8B" HorizontalAlignment="Center"/><TextBlock x:Name="OkCountText" Text="0" Foreground="#4CAF50" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="NG" Foreground="#607D8B" HorizontalAlignment="Center"/><TextBlock x:Name="NgCountText" Text="0" Foreground="#F44336" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel>
                            <StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Text="良率" Foreground="#607D8B" HorizontalAlignment="Center"/><TextBlock x:Name="YieldText" Text="0.00%" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel>
                        </Grid>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="运行日志" Style="{StaticResource SectionTitleStyle}"/>
                        <ListBox Grid.Row="1" x:Name="LogList" BorderThickness="0" Background="#FAFAFA"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding}" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" Foreground="#37474F" TextWrapping="Wrap" Padding="4,3"/></DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#ECEFF1" BorderBrush="#CFD8DC" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="系统待机" VerticalAlignment="Center" Foreground="#455A64" FontSize="12"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="PlcIndicator" Width="10" Height="10" Fill="#90A4AE" Margin="8,0,5,0"/><TextBlock Text="PLC" VerticalAlignment="Center" FontSize="11"/>
                    <Ellipse x:Name="CameraIndicator" Width="10" Height="10" Fill="#90A4AE" Margin="14,0,5,0"/><TextBlock Text="相机" VerticalAlignment="Center" FontSize="11"/>
                    <Ellipse x:Name="ModelIndicator" Width="10" Height="10" Fill="#90A4AE" Margin="14,0,5,0"/><TextBlock Text="模型" VerticalAlignment="Center" FontSize="11"/>
                    <Ellipse x:Name="OverallIndicator" Width="10" Height="10" Fill="#90A4AE" Margin="14,0,5,0"/><TextBlock Text="总结果" VerticalAlignment="Center" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
