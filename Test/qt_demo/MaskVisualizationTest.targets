<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildThisFileDirectory)..\..\build_script\OpenCvDiagnostics.targets" />
  <Target Name="CopyMaskTestRuntime" AfterTargets="Build" DependsOnTargets="ValidateOpenCvRuntime">
    <ItemGroup>
      <_MaskTestRuntime Include="$(QtBinDir)\Qt6Core$(QtDllSuffix).dll;$(QtBinDir)\Qt6Gui$(QtDllSuffix).dll;$(QtBinDir)\Qt6Widgets$(QtDllSuffix).dll;$(OpenCvBinDir)\$(OpenCvWorldDebugDll)" Condition="'$(Configuration)'=='Debug'" />
      <_MaskTestRuntime Include="$(QtBinDir)\Qt6Core$(QtDllSuffix).dll;$(QtBinDir)\Qt6Gui$(QtDllSuffix).dll;$(QtBinDir)\Qt6Widgets$(QtDllSuffix).dll;$(OpenCvBinDir)\$(OpenCvWorldReleaseDll)" Condition="'$(Configuration)'!='Debug'" />
    </ItemGroup>
    <Copy SourceFiles="@(_MaskTestRuntime)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <MakeDir Directories="$(TargetDir)platforms" />
    <Copy SourceFiles="$(QtPluginsDir)\platforms\qoffscreen$(QtDllSuffix).dll" DestinationFolder="$(TargetDir)platforms" SkipUnchangedFiles="true" />
    <MakeDir Directories="$(TargetDir)imageformats" Condition="'$(MaskTestDefinition)'=='DLCV_QT_C_MASK_TEST'" />
    <Copy SourceFiles="$(QtPluginsDir)\imageformats\qgif$(QtDllSuffix).dll" DestinationFolder="$(TargetDir)imageformats" SkipUnchangedFiles="true" Condition="'$(MaskTestDefinition)'=='DLCV_QT_C_MASK_TEST'" />
  </Target>
</Project>
