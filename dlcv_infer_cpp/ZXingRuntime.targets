<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- ZXing 运行时统一解析：环境变量 > 仓库 third_party\zxing-cpp\bin > 工程目录 > DLCV 共享运行时 > NuGet 包。
       ZXing.dll 不入库，每台机器把文件放到上述任一位置即可。 -->
  <PropertyGroup>
    <DlcvZXingRepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</DlcvZXingRepoRoot>
    <ZXingRuntimeFile Condition="'$(ZXingRuntimeFile)'=='' and '$(DLCV_ZXING_DLL)'!='' and Exists('$(DLCV_ZXING_DLL)')">$(DLCV_ZXING_DLL)</ZXingRuntimeFile>
    <ZXingRuntimeFile Condition="'$(ZXingRuntimeFile)'=='' and '$(ZXING_DIR)'!='' and Exists('$(ZXING_DIR)\ZXing.dll')">$(ZXING_DIR)\ZXing.dll</ZXingRuntimeFile>
    <ZXingRuntimeFile Condition="'$(ZXingRuntimeFile)'=='' and '$(ZXING_DIR)'!='' and Exists('$(ZXING_DIR)\bin\ZXing.dll')">$(ZXING_DIR)\bin\ZXing.dll</ZXingRuntimeFile>
    <ZXingRuntimeFile Condition="'$(ZXingRuntimeFile)'=='' and Exists('$(DlcvZXingRepoRoot)\third_party\zxing-cpp\bin\ZXing.dll')">$(DlcvZXingRepoRoot)\third_party\zxing-cpp\bin\ZXing.dll</ZXingRuntimeFile>
    <ZXingRuntimeFile Condition="'$(ZXingRuntimeFile)'=='' and Exists('$(DlcvZXingRepoRoot)\third_party\zxing-cpp\ZXing.dll')">$(DlcvZXingRepoRoot)\third_party\zxing-cpp\ZXing.dll</ZXingRuntimeFile>
    <ZXingRuntimeFile Condition="'$(ZXingRuntimeFile)'=='' and Exists('$(MSBuildThisFileDirectory)ZXing.dll')">$(MSBuildThisFileDirectory)ZXing.dll</ZXingRuntimeFile>
    <ZXingRuntimeFile Condition="'$(ZXingRuntimeFile)'=='' and Exists('C:\dlcv\bin\ZXing.dll')">C:\dlcv\bin\ZXing.dll</ZXingRuntimeFile>
    <ZXingRuntimeFile Condition="'$(ZXingRuntimeFile)'=='' and Exists('$(DlcvZXingRepoRoot)\packages\ZXingCpp.0.5.3\runtimes\win-x64\native\ZXing.dll')">$(DlcvZXingRepoRoot)\packages\ZXingCpp.0.5.3\runtimes\win-x64\native\ZXing.dll</ZXingRuntimeFile>
  </PropertyGroup>
  <Target Name="CopyZXingRuntime" AfterTargets="Build" Condition="'$(Platform)'=='x64'">
    <Error Condition="'$(ZXingRuntimeFile)'==''" Text="缺少 ZXing.dll。把 ZXing.dll 放到 third_party\zxing-cpp\bin\ZXing.dll，或设置环境变量 DLCV_ZXING_DLL 指向该文件，或放进 C:\dlcv\bin。" />
    <Copy SourceFiles="$(ZXingRuntimeFile)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
